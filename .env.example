# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose reads these too)
POSTGRES_USER=trustfit
POSTGRES_PASSWORD=trustfit
POSTGRES_DB=trustfit
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql+psycopg://trustfit:trustfit@localhost:5432/trustfit
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
# Fixed scoring date (YYYY-MM-DD). Leave empty to score as of today. Golden tests use 2026-10-24.
SCORING_AS_OF=
# Seed users (python -m app.seed). Change every password outside local dev.
SEED_ADMIN_EMAIL=admin@trustfit.local
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ANALYST_EMAIL=analyst@trustfit.local
SEED_ANALYST_PASSWORD=change-me-analyst
SEED_VIEWER_EMAIL=viewer@trustfit.local
SEED_VIEWER_PASSWORD=change-me-viewer
# Test database for the API tests (created if missing).
TEST_DATABASE_URL=postgresql+psycopg://trustfit:trustfit@localhost:5432/trustfit_test
CORS_ORIGINS=["http://localhost:3000"]

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
